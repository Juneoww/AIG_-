FROM mcr.microsoft.com/devcontainers/python:1-3.10-bookworm AS python
FROM scratch
COPY --from=python /usr/local/bin/python3.10 /usr/local/bin/python3
COPY --from=python /usr/local/lib/libpython3.10.so.1.0 /usr/local/lib/libpython3.10.so.1.0
COPY --from=python /usr/local/lib/python3.10 /usr/local/lib/python3.10
COPY --from=python /lib/x86_64-linux-gnu/ /lib/x86_64-linux-gnu/
COPY --from=python /lib64/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2
COPY --from=python /bin/sh /bin/cp /bin/ls /bin/
COPY fake_service.py /app/fake_service.py
COPY --chmod=755 curl_fixture.py /usr/local/bin/curl
COPY --from=python /usr/local/bin/python3.10 /app/api-checker-venv/bin/python
ENV LD_LIBRARY_PATH=/usr/local/lib PATH=/usr/local/bin:/bin PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/python3", "/app/fake_service.py"]
